LLM_PROVIDER=meta

META_API_KEY=your_key_here
META_BASE_URL=https://api.meta.ai/v1

META_AGENT_MODEL=muse-spark-1.3
META_GUARD_MODEL=muse-spark-1.3
META_PLANNER_MODEL=muse-wonder

META_TIMEOUT=60

# Segmentation backend: auto (hosted SAM 3.1 when META_API_KEY + meta-sam-parser
# are present, else local ViT-B), api (require hosted SAM 3.1), or local.
SAM_BACKEND=auto

# Legacy Ollama path (LLM_PROVIDER=ollama only). Uncomment to run fully local
# instead of the Meta Model API.
# OLLAMA_MAIN_URL=http://127.0.0.1:11434
# OLLAMA_GUARD_URL=http://192.168.1.72:11434
# GUARD_MODEL=llama-guard3:1b
# INTENT_MODEL=llama3.2:3b
# PLANNER_MODEL=llama3.2:3b
# SUMMARY_MODEL=llama3.2:3b

NETWORK_MODE=local_only
